{
  "name": "@pkg/shared",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js",
      "require": "./dist/common/index.cjs",
      "default": "./dist/common/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs",
      "default": "./dist/server/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "require": "./dist/web/index.cjs",
      "default": "./dist/web/index.js"
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "check": "pnpm exec tsc -p tsconfig.app.json --noEmit && pnpm exec tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@swc/core": "1.15.24",
    "@types/bcrypt": "6.0.0",
    "@types/lodash": "4.17.24",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.6.0",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.27.7",
    "esbuild-plugin-swc": "1.0.1",
    "eslint": "9.39.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mikro-orm/core": "7.0.10",
    "@nestjs/common": "11.0.11",
    "@nestjs/microservices": "11.0.11",
    "@nestjs/swagger": "11.3.0",
    "@swc/helpers": "0.5.21",
    "bcrypt": "6.0.0",
    "jose": "6.2.3",
    "lodash": "4.18.1",
    "nestjs-cls": "6.2.0",
    "rxjs": "7.8.2"
  }
}
