# platform-core-service production secrets
# Copy this file to platform-core-service-secret.env and fill in actual values
DATABASE_URL=postgresql://prod_platform_user:CHANGE_ME@postgres-rw.prod-infra.svc.cluster.local:5432/platform_db
REDIS_URL=redis://default:CHANGE_ME@redis-leader.prod-infra.svc.cluster.local:6379
JWT_ACCESS_SECRET=CHANGE_ME_PROD_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_PROD_REFRESH_SECRET

# Direct SMTP
# MAIL_USER is the SMTP username and defaults to the from address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password
