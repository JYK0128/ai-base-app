# platform-service production secrets
# Copy this file to platform-service-secret.env and fill in actual values
DATABASE_URL=postgresql://platform_user:prod_postgres_password@postgres-rw.prod-infra.svc.cluster.local:5432/platform_db
REDIS_URL=redis://default:prod_redis_password@redis-leader.prod-infra.svc.cluster.local:6379
RABBITMQ_URL=amqp://prod_rabbitmq_user:prod_rabbitmq_password@rabbitmq.prod-infra.svc.cluster.local:5672?frameMax=8192
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace_me_mail_user
MAIL_PASS=replace_me_mail_pass

# Auth policy
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_TTL=300
LOGIN_LOCK_TTL=1800
PASSWORD_EXPIRY_DAYS=90
