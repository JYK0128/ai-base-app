NODE_ENV=development
PORT=3004
TCP_PORT=3005

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# Redis
REDIS_URL=redis://default:password@localhost:6379

# JWT secrets
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Token expiration (seconds)
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Mail Configuration (direct SMTP)
# MAIL_USER is the SMTP username and defaults to the from address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# RabbitMQ Connection URL
RABBITMQ_URL=amqp://dev_rabbitmq_user:dev_rabbitmq_password@rabbitmq.dev-infra.svc.cluster.local:5672?frameMax=8192
